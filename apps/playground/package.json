{
  "name": "@vibecook/spaghetti-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "pnpm -F @vibecook/spaghetti-sdk build && node scripts/ensure-electron.mjs && electron-rebuild -f -w better-sqlite3",
    "prestart": "pnpm -F @vibecook/spaghetti-sdk build && node scripts/ensure-electron.mjs && electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "pnpm -F @vibecook/spaghetti-sdk build && node scripts/ensure-electron.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "clean": "rm -rf out",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm -w rebuild better-sqlite3"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-virtual": "^3.14.6",
    "@vibecook/mille": "0.2.1",
    "@vibecook/mille-ui": "0.2.1",
    "@vibecook/spaghetti-sdk": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^41.0.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
