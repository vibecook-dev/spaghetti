  "policy": {
    "undocumentedBucket": "fail",
    "zeroCountUndocumented": "ignore",
    "requireClaimForToplevelWithBytes": true,
    "minBytesForToplevelClaim": 1,
    "requireClaimForRecordTypesWithCount": true,
    "minCountForRecordTypeClaim": 1
  }
