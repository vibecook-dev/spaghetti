    {
      "id": "rollout.record_type.world_state",
      "status": "ignored",
      "match": { "recordType": "world_state" },
      "engines": { "ts": false, "rs": false }
    },
    {
      "id": "rollout.record_type.inter_agent_communication_metadata",
      "status": "ignored",
      "match": { "recordType": "inter_agent_communication_metadata" },
      "engines": { "ts": false, "rs": false },
      "notes": "Internal collaboration control metadata, not a transcript event."
    },
    {
      "id": "rollout.record_type.response_item/agent_message",
      "status": "ignored",
      "match": { "recordType": "response_item/agent_message" },
      "engines": { "ts": false, "rs": false },
      "notes": "Internal sub-agent coordination payload; guardian/sub-agent rollouts are excluded from the user session list."
    },
    {
      "id": "rollout.record_type.event_msg/*",
      "status": "ignored",
      "match": { "recordTypePrefix": "event_msg/" },
      "engines": { "ts": false, "rs": false },
      "notes": "UI/telemetry projection stream (except token_count partial). Prefer response_item as canonical. Prefix match covers agent_message, exec_command_*, patch_*, etc."
    },
    {
      "id": "toplevel.sessions",
      "status": "ingested",
      "match": { "toplevel": "sessions" },
      "engines": { "ts": true, "rs": true },
      "product": ["projects", "sessions", "messages"]
    },
    {
      "id": "toplevel.config.toml",
      "status": "ignored",
      "match": { "toplevel": "config.toml" },
      "engines": { "ts": false, "rs": false },
