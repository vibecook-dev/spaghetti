{
  "schemaVersion": 1,
  "agentId": "codex",
  "updated": "2026-07-18",
  "rootDefault": "~/.codex",
  "description": "Coverage claim for OpenAI Codex CLI. Canonical response_item chat, tool calls/results, and readable reasoning are retained and normalized into the database-backed timeline; duplicate event projections and side artifacts remain deliberately unproductized.",
  "engines": {
    "ts": "packages/sdk sources/codex + CodexLifecycleOwner (fallback)",
    "rs": "crates/spaghetti-napi codex reader (cold/warm); live still TS"
  },
  "surfaces": [
    {
      "id": "rollout.file",
      "status": "ingested",
      "match": { "bucket": "rollout.file" },
      "engines": { "ts": true, "rs": true },
      "product": ["projects", "sessions"],
      "notes": "sessions/**/rollout-*.jsonl discovered by CodexReader (TS + RS)."
    },
    {
      "id": "rollout.record_type.response_item/message",
      "status": "ingested",
      "match": { "recordType": "response_item/message" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "search", "fts"],
      "notes": "Chat turns retained verbatim; role and readable content are projected for facets, search, and timeline display."
    },
    {
      "id": "rollout.record_type.event_msg/token_count",
      "status": "partial",
      "match": { "recordType": "event_msg/token_count" },
      "engines": { "ts": true, "rs": true },
      "product": ["tokens"],
      "notes": "Not stored as rows; last_token_usage attributed onto prior assistant. TS also tiktoken-estimates when missing; RS attributes official counts only (no tiktoken yet)."
    },
    {
      "id": "rollout.record_type.session_meta",
      "status": "partial",
      "match": { "recordType": "session_meta" },
      "engines": { "ts": true, "rs": true },
      "product": ["projects", "sessions"],
      "notes": "Peeked for cwd + session id; not stored as a message row."
    },
    {
      "id": "rollout.record_type.response_item/function_call",
      "status": "ingested",
      "match": { "recordType": "response_item/function_call" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools", "fts"],
      "notes": "Retained verbatim and normalized as tool_use; arguments are parsed for display and call_id pairs the result."
    },
    {
      "id": "rollout.record_type.response_item/function_call_output",
      "status": "ingested",
      "match": { "recordType": "response_item/function_call_output" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools"],
      "notes": "Retained verbatim and paired with function_call via call_id."
    },
    {
      "id": "rollout.record_type.response_item/custom_tool_call",
      "status": "ingested",
      "match": { "recordType": "response_item/custom_tool_call" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools", "fts"],
      "notes": "Retained verbatim and normalized as tool_use; non-JSON input remains readable source text."
    },
    {
      "id": "rollout.record_type.response_item/custom_tool_call_output",
      "status": "ingested",
      "match": { "recordType": "response_item/custom_tool_call_output" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools"],
      "notes": "Retained verbatim and paired with custom_tool_call via call_id."
    },
    {
      "id": "rollout.record_type.response_item/reasoning",
      "status": "partial",
      "match": { "recordType": "response_item/reasoning" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "fts"],
      "notes": "Every raw record is retained. Readable summary blocks are indexed/rendered as thinking; encrypted_content is opaque and produces no blank UI row."
    },
    {
      "id": "rollout.record_type.response_item/web_search_call",
      "status": "ingested",
      "match": { "recordType": "response_item/web_search_call" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools"],
      "notes": "Normalized generically as tool_use from the *_call record."
    },
    {
      "id": "rollout.record_type.response_item/tool_search_call",
      "status": "ingested",
      "match": { "recordType": "response_item/tool_search_call" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools"],
      "notes": "Normalized as tool_use and paired with tool_search_output by call_id."
    },
    {
      "id": "rollout.record_type.response_item/tool_search_output",
      "status": "ingested",
      "match": { "recordType": "response_item/tool_search_output" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools"],
      "notes": "Known naming exception to *_call_output; tools catalog is rendered as the paired result."
    },
    {
      "id": "rollout.record_type.turn_context",
      "status": "ignored",
      "match": { "recordType": "turn_context" },
      "engines": { "ts": false, "rs": false }
    },
    {
      "id": "rollout.record_type.compacted",
      "status": "ignored",
      "match": { "recordType": "compacted" },
      "engines": { "ts": false, "rs": false }
