{
  "schemaVersion": 1,
  "agentId": "grok",
  "updated": "2026-07-18",
  "rootDefault": "~/.grok",
  "description": "Honest coverage claim for Grok CLI (xAI). Rich canonical chat-history ingestion with human/context classification, reasoning, embedded/local/backend tools, paired results, search, timestamps, tokens, and live rewrites.",
  "engines": {
    "ts": "packages/sdk sources/grok + GrokLifecycleOwner (fallback)",
    "rs": "crates/spaghetti-napi grok reader (cold/warm) + liveIngestBatch via writeBatch when engine=rs"
  },
  "surfaces": [
    {
      "id": "chat_history.file",
      "status": "ingested",
      "match": { "bucket": "chat_history.file" },
      "engines": { "ts": true, "rs": true },
      "product": ["projects", "sessions", "messages"],
      "notes": "sessions/<url-encoded-cwd>/<uuid>/chat_history.jsonl discovered by GrokReader (TS + RS)."
    },
    {
      "id": "chat_history.record_type.system",
      "status": "ingested",
      "match": { "recordType": "system" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages"],
      "notes": "Retained losslessly as raw model context; excluded from transcript and FTS."
    },
    {
      "id": "chat_history.record_type.user",
      "status": "ingested",
      "match": { "recordType": "user" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "search", "fts"],
      "notes": "synthetic_reason, user_info and reminders are classified as context; user_query is unwrapped; image-only human rows get a readable attachment label."
    },
    {
      "id": "chat_history.record_type.assistant",
      "status": "ingested",
      "match": { "recordType": "assistant" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools", "search", "fts", "tokens"],
      "notes": "Prose and every embedded tool_calls[] entry expand into independently filterable timeline rows."
    },
    {
      "id": "chat_history.record_type.reasoning",
      "status": "ingested",
      "match": { "recordType": "reasoning" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "search", "fts"],
      "notes": "Readable summary[] becomes thinking; empty/opaque reasoning stays raw but is hidden. encrypted_content is not decoded."
    },
    {
      "id": "chat_history.record_type.tool_result",
      "status": "ingested",
      "match": { "recordType": "tool_result" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools", "search", "fts"],
      "notes": "Retained losslessly and paired to embedded calls by tool_call_id during timeline materialization."
    },
    {
      "id": "chat_history.record_type.backend_tool_call",
      "status": "ingested",
      "match": { "recordType": "backend_tool_call" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages", "timeline", "tools", "search", "fts"],
      "notes": "Standalone backend calls (currently web_search) become tool timeline rows."
    },
    {
      "id": "chat_history.embedded_tool_call",
      "status": "ingested",
      "match": { "bucket": "chat_history.embedded_tool_call" },
      "engines": { "ts": true, "rs": true },
      "product": ["timeline", "tools", "search"],
      "notes": "Every assistant.tool_calls[] item expands independently; no top-N cap."
    },
    {
      "id": "sibling.summary.json",
      "status": "partial",
      "match": { "bucket": "sibling.summary.json" },
      "engines": { "ts": true, "rs": true },
      "product": ["projects", "sessions"],
      "notes": "Meta only: cwd, id, title, times, branch — not a message row."
    },
    {
      "id": "sibling.events.jsonl",
      "status": "partial",
      "match": { "bucket": "sibling.events.jsonl" },
      "engines": { "ts": true, "rs": true },
      "product": ["messages"],
      "notes": "Turn-scoped timestamp join onto message columns; compaction counter resets select the latest valid epoch. Events themselves are not stored as rows."
    },
    {
      "id": "sibling.signals.json",
      "status": "partial",
      "match": { "bucket": "sibling.signals.json" },
      "engines": { "ts": true, "rs": true },
      "product": ["tokens"],
      "notes": "contextTokensUsed attributed to last assistant; tokens_estimated=1."
    },
    {
      "id": "sibling.updates.jsonl",
      "status": "ignored",
      "match": { "bucket": "sibling.updates.jsonl" },
      "engines": { "ts": false, "rs": false },
      "notes": "ACP/UI stream, often ~10× chat_history. Not transcript SoT."
    },
    {
      "id": "compaction.segment.file",
      "status": "ignored",
      "match": { "bucket": "compaction.segment.file" },
      "engines": { "ts": false, "rs": false },
      "notes": "Historical Markdown snapshots are often truncated relative to their declared turn counts and overlap canonical chat history. They are inventoried but not merged into the transcript because chronology and deduplication cannot be losslessly established."
    },
    {
      "id": "toplevel.sessions",
      "status": "ingested",
      "match": { "toplevel": "sessions" },
      "engines": { "ts": true, "rs": true },
      "product": ["projects", "sessions"],
      "notes": "Session tree root under ~/.grok/sessions."
    },
    {
      "id": "toplevel.user-settings.json",
      "status": "ignored",
      "match": { "toplevel": "user-settings.json" },
      "engines": { "ts": false, "rs": false },
      "notes": "Agent prefs; not indexed."
    },
    {
      "id": "toplevel.glob.sqlite",
      "status": "ignored",
      "match": { "toplevelGlob": "*.sqlite*" },
      "engines": { "ts": false, "rs": false },
      "notes": "Derived indexes (e.g. session_search) — not canonical transcript."
    },
    {
      "id": "toplevel.glob.misc",
      "status": "ignored",
      "match": { "toplevelGlob": "*" },
      "engines": { "ts": false, "rs": false },
      "notes": "Catch-all for other root files/dirs (logs, caches). Claim so non-empty roots do not fail validation."
    }
  ]
}
