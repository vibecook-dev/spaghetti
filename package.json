{
  "name": "spaghetti",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Local-first Claude Code explorer for searching sessions, browsing agent artifacts, and querying your history from the terminal",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibecook-dev/spaghetti.git"
  },
  "homepage": "https://github.com/vibecook-dev/spaghetti",
  "packageManager": "pnpm@11.13.1",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "conversation",
    "history",
    "search",
    "sqlite"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "generate:types": "node scripts/generate-types.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "pnpm --dir packages/sdk exec tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --types node --skipLibCheck ../../scripts/bench-queries.ts ../../scripts/bench-observation.ts ../../scripts/observation-diff.ts ../../scripts/adapter-check.ts",
    "validate": "bash scripts/validate-all.sh",
    "coverage:scan": "python3 scripts/coverage/run_scan.py all",
    "coverage:validate": "python3 scripts/coverage/validate_claim.py all",
    "coverage:check": "python3 scripts/coverage/run_validate.py all --rescan",
    "coverage:report": "python3 scripts/coverage/build_report.py",
    "experiment:catalog-census": "python3 scripts/catalog_census/census.py",
    "experiment:diagnostic-census": "python3 scripts/diagnostic_census/census.py",
    "experiment:runtime-observation-census": "python3 scripts/runtime_observation_census/census.py",
    "experiment:team-affiliation-census": "python3 scripts/team_affiliation_census/census.py",
    "test:catalog-census": "python3 scripts/catalog_census/test_census.py",
    "test:runtime-observation-census": "python3 scripts/runtime_observation_census/test_census.py",
    "test:team-affiliation-census": "python3 scripts/team_affiliation_census/test_census.py",
    "test:usage-v2-oracle": "python3 scripts/usage_v2_oracle/test_oracle.py",
    "agent-support:validate": "python3 scripts/agent_support/validate.py",
    "test:agent-support": "python3 -m unittest scripts.agent_support.test_contracts",
    "test:packages": "pnpm --filter @vibecook/spaghetti-sdk test && pnpm --filter @vibecook/spaghetti test && pnpm --filter @vibecook/spaghetti-playground test",
    "test:ingest-diff": "node scripts/run-legacy-oracle.mjs scripts/ingest-diff.ts",
    "test:ingest-diff:medium": "node scripts/run-legacy-oracle.mjs scripts/ingest-diff.ts --fixture crates/spaghetti-napi/fixtures/medium/.claude",
    "test:ingest-diff:grok": "node scripts/run-legacy-oracle.mjs scripts/ingest-diff.ts --source=grok",
    "test:ingest-diff:codex": "node scripts/run-legacy-oracle.mjs scripts/ingest-diff.ts --source=codex",
    "test:observation-diff": "node --import tsx scripts/observation-diff.ts",
    "test:observation-diff:medium": "node --import tsx scripts/observation-diff.ts --fixture crates/spaghetti-napi/fixtures/medium/.claude",
    "test:observation-diff:codex": "node --import tsx scripts/observation-diff.ts --adapter codex",
    "test:observation-diff:grok": "node --import tsx scripts/observation-diff.ts --adapter grok",
    "adapter-check": "node --import tsx scripts/adapter-check.ts --all",
    "test:query-conformance": "node --import tsx scripts/bench-queries.ts --mode conformance",
    "bench:ingest": "node scripts/run-legacy-oracle.mjs --release scripts/bench-ingest.ts",
    "bench:observation": "node --import tsx scripts/bench-observation.ts",
    "bench:queries": "node --import tsx scripts/bench-queries.ts",
    "bench:query-topology": "pnpm --filter @vibecook/spaghetti-playground bench:query-topology",
    "check:sdk-package": "node scripts/check-sdk-package.mjs",
    "test": "pnpm typecheck && pnpm validate && pnpm test:packages",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx}\" \"scripts/bench-queries.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx}\" \"scripts/bench-queries.ts\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx}\" \"scripts/bench-queries.ts\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.57.2"
  }
}
