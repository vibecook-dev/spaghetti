{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaghetti.dev/schemas/rfc012a/agent-data-surface-v1.json",
  "title": "RFC 012A Agent Data Surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ads_id",
    "adapter_id",
    "status",
    "native_artifact",
    "source_instance",
    "object_families",
    "entity_identity_rules",
    "association_rules",
    "join_rules",
    "scope_program_manifest",
    "size_limits",
    "privacy",
    "claim_refs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "ads_id": { "$ref": "#/$defs/id" },
    "adapter_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["candidate", "promoted", "retired"] },
    "native_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "target", "identification", "platforms", "relevant_flags", "claim_refs"],
      "properties": {
        "family": { "$ref": "#/$defs/id" },
        "target": { "type": "string", "minLength": 1 },
        "identification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "version_markers", "artifact_digest"],
          "properties": {
            "state": { "enum": ["pinned", "range_backed", "recognized_unverified", "unknown"] },
            "version_markers": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
            "artifact_digest": { "$ref": "#/$defs/nullableDigest" }
          }
        },
        "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "relevant_flags": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "claim_refs": { "$ref": "#/$defs/claimRefs" }
      }
    },
    "source_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_contract_version",
        "derivation",
        "canonical_roots",
        "move_behavior",
        "clone_behavior",
        "replacement_behavior",
        "cross_device_behavior",
        "access_policy",
        "claim_refs"
      ],
      "properties": {
        "identity_contract_version": { "type": "integer", "minimum": 1 },
        "derivation": { "enum": ["configured_canonical_root", "native_installation_id", "composite"] },
        "canonical_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root_id", "relative_to", "relative_path", "required"],
            "properties": {
              "root_id": { "$ref": "#/$defs/id" },
              "relative_to": { "enum": ["configured_root", "declared_root"] },
              "relative_path": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "move_behavior": { "$ref": "#/$defs/behavior" },
        "clone_behavior": { "$ref": "#/$defs/behavior" },
        "replacement_behavior": { "$ref": "#/$defs/behavior" },
        "cross_device_behavior": { "$ref": "#/$defs/behavior" },
        "access_policy": { "enum": ["configured_roots_only", "native_installation_only"] },
        "claim_refs": { "$ref": "#/$defs/claimRefs" }
      }
    },
    "object_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "source_schema_versions",
          "stream_ids",
          "native_shapes",
          "framing",
          "lifecycle",
          "identity_inputs",
          "disposition",
          "timestamp_quality",
          "missing_vs_zero",
          "unknown_field_policy",
          "claim_refs"
        ],
        "properties": {
          "family_id": { "$ref": "#/$defs/id" },
          "source_schema_versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "stream_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "native_shapes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "framing": { "enum": ["json_lines", "json_document", "text_document", "directory_membership", "presence", "sqlite_rows", "key_values"] },
          "lifecycle": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["append", "partial_write", "replace", "truncate", "rotate", "delete", "recreate", "compact", "membership_change"] },
            "uniqueItems": true
          },
          "identity_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "disposition": { "enum": ["mapped", "ignored_known", "retained_unknown", "unsupported_version"] },
          "timestamp_quality": { "enum": ["native_exact", "native_approximate", "filesystem_only", "absent", "mixed"] },
          "missing_vs_zero": { "enum": ["distinct", "native_ambiguous", "not_applicable"] },
          "unknown_field_policy": { "enum": ["retain_bounded", "measure_only", "reject_version", "not_applicable"] },
          "claim_refs": { "$ref": "#/$defs/claimRefs" }
        }
      }
    },
    "entity_identity_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_kind", "primary_inputs", "fallback_inputs", "reuse_behavior", "supersession_behavior", "claim_refs"],
        "properties": {
          "entity_kind": { "$ref": "#/$defs/id" },
          "primary_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "fallback_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "reuse_behavior": { "enum": ["never_reuse", "native_reuse_detected", "unverified"] },
          "supersession_behavior": { "enum": ["explicit", "generation_scoped", "unverified"] },
          "claim_refs": { "$ref": "#/$defs/claimRefs" }
        }
      }
    },
    "association_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["association_id", "from_kind", "to_kind", "precedence", "conflict_behavior", "claim_refs"],
        "properties": {
          "association_id": { "$ref": "#/$defs/id" },
          "from_kind": { "$ref": "#/$defs/id" },
          "to_kind": { "$ref": "#/$defs/id" },
          "precedence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "conflict_behavior": { "enum": ["retain_conflict", "authoritative_wins", "unavailable"] },
          "claim_refs": { "$ref": "#/$defs/claimRefs" }
        }
      }
    },
    "join_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["join_id", "inputs", "output", "max_fan_out", "ambiguous_behavior", "claim_refs"],
        "properties": {
          "join_id": { "$ref": "#/$defs/id" },
          "inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "output": { "type": "string", "minLength": 1 },
          "max_fan_out": { "type": "integer", "minimum": 1 },
          "ambiguous_behavior": { "enum": ["report_ambiguous", "report_unavailable", "deterministic_precedence"] },
          "claim_refs": { "$ref": "#/$defs/claimRefs" }
        }
      }
    },
    "scope_program_manifest": { "type": "string", "minLength": 1 },
    "size_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit_id", "applies_to", "max_bytes", "claim_refs"],
        "properties": {
          "limit_id": { "$ref": "#/$defs/id" },
          "applies_to": { "type": "string", "minLength": 1 },
          "max_bytes": { "type": "integer", "minimum": 1 },
          "claim_refs": { "$ref": "#/$defs/claimRefs" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_capture_policy", "committed_fixture_policy", "retention", "prohibited_categories", "claim_refs"],
      "properties": {
        "raw_capture_policy": { "const": "private_never_commit" },
        "committed_fixture_policy": { "const": "deterministically_sanitized_or_synthetic" },
        "retention": { "enum": ["none", "hash_only", "bounded_structural"] },
        "prohibited_categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "claim_refs": { "$ref": "#/$defs/claimRefs" }
      }
    },
    "claim_refs": { "$ref": "#/$defs/claimRefs" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "claimRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "behavior": { "enum": ["same_instance", "new_instance", "explicit_supersession", "unverified"] }
  }
}
