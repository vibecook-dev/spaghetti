{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaghetti.dev/schemas/rfc012a/source-declaration-v1.json",
  "title": "RFC 012A bounded source declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "declaration_id", "adapter_id", "ads_id", "status", "streams", "claim_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "declaration_id": { "$ref": "#/$defs/id" },
    "adapter_id": { "$ref": "#/$defs/id" },
    "ads_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["candidate", "promoted", "retired"] },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stream_id",
          "family_id",
          "root_id",
          "relative_patterns",
          "primitive",
          "topologies",
          "implementation_state",
          "decoder_id",
          "authority",
          "bounds",
          "lifecycle",
          "overlap_strategy",
          "safe_decoder_state_boundary",
          "disposition_ownership",
          "claim_refs"
        ],
        "properties": {
          "stream_id": { "$ref": "#/$defs/id" },
          "family_id": { "$ref": "#/$defs/id" },
          "root_id": { "$ref": "#/$defs/id" },
          "relative_patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "primitive": { "$ref": "#/$defs/primitive" },
          "topologies": { "type": "array", "minItems": 1, "items": { "enum": ["catalog", "durable", "scoped"] }, "uniqueItems": true },
          "implementation_state": { "enum": ["existing", "planned"] },
          "decoder_id": { "$ref": "#/$defs/id" },
          "authority": { "enum": ["canonical", "supplemental", "diagnostic", "ignored_derived"] },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "max_object_bytes": { "$ref": "#/$defs/positive" },
              "max_record_bytes": { "$ref": "#/$defs/positive" },
              "max_batch_bytes": { "$ref": "#/$defs/positive" },
              "max_records_per_batch": { "$ref": "#/$defs/positive" },
              "max_entries": { "$ref": "#/$defs/positive" },
              "max_depth": { "$ref": "#/$defs/positive" },
              "max_rows": { "$ref": "#/$defs/positive" },
              "max_value_bytes": { "$ref": "#/$defs/positive" }
            }
          },
          "lifecycle": { "type": "array", "minItems": 1, "items": { "enum": ["append", "partial_write", "replace", "truncate", "identity_change", "delete", "recreate", "membership_change"] }, "uniqueItems": true },
          "overlap_strategy": { "enum": ["commit_catalog_facts", "idempotent_overlap", "disjoint_catalog_family", "full_only"] },
          "safe_decoder_state_boundary": { "enum": ["object_generation_cursor", "object_generation_revision", "stateless_record", "full_snapshot"] },
          "disposition_ownership": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "claim_refs": { "$ref": "#/$defs/claimRefs" }
        }
      }
    },
    "claim_refs": { "$ref": "#/$defs/claimRefs" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "positive": { "type": "integer", "minimum": 1 },
    "claimRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "primitive": { "enum": ["AppendDelimited", "ReplaceDocument", "DirectoryMembership", "PresenceObject", "SQLiteSnapshot", "KeyValueSnapshot", "DelimitedHead", "DelimitedPrefix"] }
  }
}
