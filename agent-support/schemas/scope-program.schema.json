{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaghetti.dev/schemas/rfc012a/scope-program-v1.json",
  "title": "RFC 012A restricted scope programs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "declaration_id",
    "adapter_id",
    "ads_id",
    "status",
    "roots",
    "programs",
    "blockers",
    "claim_refs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "declaration_id": { "$ref": "#/$defs/id" },
    "adapter_id": { "$ref": "#/$defs/id" },
    "ads_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["incomplete", "candidate", "promoted", "retired"] },
    "roots": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["program_id", "root_entity_kind", "relations", "claim_refs"],
        "properties": {
          "program_id": { "$ref": "#/$defs/id" },
          "root_entity_kind": { "$ref": "#/$defs/id" },
          "root_relation_id": { "$ref": "#/$defs/id" },
          "relations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relation_id",
                "primitive",
                "access_root",
                "locator",
                "identity_inputs",
                "bounds",
                "unavailable_behavior",
                "claim_refs"
              ],
              "properties": {
                "relation_id": { "$ref": "#/$defs/id" },
                "primitive": {
                  "enum": [
                    "KnownObject",
                    "SiblingObject",
                    "ChildDirectoryByNativeId",
                    "ReferencedObjectFromField",
                    "BoundedIndexLookup",
                    "ParameterizedSQLiteRows",
                    "KeyNamespace",
                    "ArtifactLocatorFromEvidence"
                  ]
                },
                "access_root": { "$ref": "#/$defs/id" },
                "locator": { "type": "string", "minLength": 1 },
                "identity_inputs": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/id" },
                  "uniqueItems": true
                },
                "directory_identity_authority": { "enum": ["configured_root", "scope_join"] },
                "bounds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["max_fan_out", "max_depth", "max_objects", "max_bytes", "max_rows"],
                  "properties": {
                    "max_fan_out": { "$ref": "#/$defs/positive" },
                    "max_depth": { "$ref": "#/$defs/positive" },
                    "max_objects": { "$ref": "#/$defs/positive" },
                    "max_bytes": { "$ref": "#/$defs/positive" },
                    "max_rows": { "$ref": "#/$defs/nonNegative" }
                  }
                },
                "statement_id": { "$ref": "#/$defs/id" },
                "parameter_names": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
                "source_binding": { "$ref": "#/$defs/sourceBinding" },
                "observation_binding": { "$ref": "#/$defs/observationBinding" },
                "unavailable_behavior": { "enum": ["record_unavailable", "skip_optional", "fail_scope"] },
                "claim_refs": { "$ref": "#/$defs/claimRefs" }
              },
              "allOf": [
                {
                  "if": { "properties": { "primitive": { "const": "ChildDirectoryByNativeId" } } },
                  "then": { "required": ["directory_identity_authority"] },
                  "else": { "not": { "required": ["directory_identity_authority"] } }
                }
              ]
            }
          },
          "claim_refs": { "$ref": "#/$defs/claimRefs" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "claim_refs": { "$ref": "#/$defs/claimRefs" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "positive": { "type": "integer", "minimum": 1 },
    "nonNegative": { "type": "integer", "minimum": 0 },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "primitive", "max_object_bytes"],
      "properties": {
        "stream_id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "ReplaceDocument" },
        "max_object_bytes": { "$ref": "#/$defs/positive" }
      }
    },
    "observationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "source_pattern"],
      "properties": {
        "stream_id": { "$ref": "#/$defs/id" },
        "source_pattern": { "$ref": "#/$defs/sourcePattern" },
        "relative_selector": { "$ref": "#/$defs/sourcePattern" }
      }
    },
    "sourcePattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[?\\[\\]{}\\u0000-\\u001f\\u007f]).+$"
    },
    "claimRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
  }
}
