{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaghetti.dev/schemas/rfc012a/evidence-manifest-v1.json",
  "title": "RFC 012A claim-addressable evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "adapter_id", "ads_id", "sanitizer", "claims"],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/id" },
    "adapter_id": { "$ref": "#/$defs/id" },
    "ads_id": { "$ref": "#/$defs/id" },
    "sanitizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "prohibited_scan", "raw_capture_committed"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "prohibited_scan": { "enum": ["pass", "pending", "fail"] },
        "raw_capture_committed": { "const": false }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "state", "sources"],
        "properties": {
          "claim_id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1 },
          "state": { "enum": ["observed", "degraded", "unsupported", "open"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "sha256", "locator"],
              "properties": {
                "kind": { "enum": ["sanitized_fixture", "code_reference", "census_report", "experiment_report", "conformance_test", "design_record"] },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/nullableDigest" },
                "locator": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
  }
}
