{
  "schema_version": 1,
  "ads_id": "factory-ads-2026-08-21-candidate",
  "adapter_id": "factory",
  "status": "candidate",
  "native_artifact": {
    "family": "factory",
    "target": "local sessions directory of jsonl transcripts plus optional session.json; distributable pin pending",
    "identification": {
      "state": "recognized_unverified",
      "version_markers": ["sessionid.shape", "record-type"],
      "artifact_digest": null
    },
    "platforms": ["darwin"],
    "relevant_flags": [],
    "claim_refs": ["factory-artifact-target-open"]
  },
  "source_instance": {
    "identity_contract_version": 1,
    "derivation": "configured_canonical_root",
    "canonical_roots": [
      { "root_id": "home", "relative_to": "configured_root", "relative_path": "", "required": true },
      { "root_id": "sessions", "relative_to": "configured_root", "relative_path": "sessions", "required": false }
    ],
    "move_behavior": "new_instance",
    "clone_behavior": "new_instance",
    "replacement_behavior": "same_instance",
    "cross_device_behavior": "new_instance",
    "access_policy": "configured_roots_only",
    "claim_refs": ["factory-source-observed", "factory-identity-open"]
  },
  "object_families": [
    {
      "family_id": "session-membership",
      "source_schema_versions": ["factory-native-object-membership-v1"],
      "stream_ids": ["session-membership"],
      "native_shapes": ["bounded membership of session jsonl and session.json filenames"],
      "framing": "directory_membership",
      "lifecycle": ["membership_change", "delete", "recreate"],
      "identity_inputs": ["source instance", "relative sidecar path", "file identity"],
      "disposition": "mapped",
      "timestamp_quality": "filesystem_only",
      "missing_vs_zero": "not_applicable",
      "unknown_field_policy": "measure_only",
      "claim_refs": ["factory-source-observed"]
    },
    {
      "family_id": "session-transcript",
      "source_schema_versions": ["factory-session-jsonl-v1"],
      "stream_ids": ["session-transcripts"],
      "native_shapes": ["<sessions>/*.jsonl"],
      "framing": "json_lines",
      "lifecycle": ["append", "partial_write", "truncate", "rotate", "delete", "recreate"],
      "identity_inputs": ["native sessionId field", "record generation and cursor"],
      "disposition": "mapped",
      "timestamp_quality": "absent",
      "missing_vs_zero": "not_applicable",
      "unknown_field_policy": "retain_bounded",
      "claim_refs": ["factory-source-observed", "factory-semantic-fixtures-open"]
    },
    {
      "family_id": "session-document",
      "source_schema_versions": ["factory-session-json-v1"],
      "stream_ids": ["session-documents"],
      "native_shapes": ["<sessions>/**/session.json"],
      "framing": "json_document",
      "lifecycle": ["replace", "delete", "recreate"],
      "identity_inputs": ["native sessionId field", "document revision"],
      "disposition": "mapped",
      "timestamp_quality": "absent",
      "missing_vs_zero": "not_applicable",
      "unknown_field_policy": "retain_bounded",
      "claim_refs": ["factory-source-observed", "factory-identity-open"]
    }
  ],
  "entity_identity_rules": [
    {
      "entity_kind": "project",
      "primary_inputs": ["source instance"],
      "fallback_inputs": ["static factory project key"],
      "reuse_behavior": "unverified",
      "supersession_behavior": "unverified",
      "claim_refs": ["factory-identity-open"]
    },
    {
      "entity_kind": "session",
      "primary_inputs": ["source instance", "native sessionId"],
      "fallback_inputs": [],
      "reuse_behavior": "unverified",
      "supersession_behavior": "generation_scoped",
      "claim_refs": ["factory-identity-open"]
    }
  ],
  "association_rules": [
    {
      "association_id": "session-project",
      "from_kind": "session",
      "to_kind": "project",
      "precedence": ["source instance"],
      "conflict_behavior": "retain_conflict",
      "claim_refs": ["factory-identity-open"]
    }
  ],
  "join_rules": [
    {
      "join_id": "session-files",
      "inputs": ["session directory", "jsonl transcript", "optional session.json"],
      "output": "one native session context",
      "max_fan_out": 2,
      "ambiguous_behavior": "report_unavailable",
      "claim_refs": ["factory-source-observed", "factory-identity-open"]
    }
  ],
  "scope_program_manifest": "agent-support/factory/2026-08-21/scope-programs.json",
  "size_limits": [
    { "limit_id": "jsonl-record", "applies_to": "session transcript records", "max_bytes": 4194304, "claim_refs": ["factory-source-observed"] },
    { "limit_id": "jsonl-batch", "applies_to": "session transcript batches", "max_bytes": 8388608, "claim_refs": ["factory-source-observed"] },
    { "limit_id": "session-document", "applies_to": "session.json documents", "max_bytes": 1048576, "claim_refs": ["factory-source-observed"] }
  ],
  "privacy": {
    "raw_capture_policy": "private_never_commit",
    "committed_fixture_policy": "deterministically_sanitized_or_synthetic",
    "retention": "hash_only",
    "prohibited_categories": ["account-identifiers", "credentials", "native-paths", "prompts", "secrets", "titles"],
    "claim_refs": ["factory-privacy-policy"]
  },
  "claim_refs": [
    "factory-artifact-target-open",
    "factory-source-observed",
    "factory-identity-open",
    "factory-semantic-fixtures-open",
    "factory-scope-open",
    "factory-privacy-policy"
  ]
}
